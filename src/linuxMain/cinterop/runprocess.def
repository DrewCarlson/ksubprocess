package = ksubprocess.iop

---
#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdio.h>

#include <sys/types.h>
#include <sys/wait.h>

static int pipe_cloexec(int* fds) {
    return pipe2(fds, O_CLOEXEC);
}

// Move fd out of the stdio range so redirecting another stream cannot overwrite it.
static int lift_fd(int* fd, int target) {
    if (*fd == -1 || *fd == target || *fd > STDERR_FILENO) {
        return 0;
    }
    *fd = fcntl(*fd, F_DUPFD_CLOEXEC, STDERR_FILENO + 1);
    return *fd == -1 ? -1 : 0;
}

// Make target refer to fd in the executed program. All parent fds are O_CLOEXEC, so the originals close on exec.
static int redirect_fd(int fd, int target) {
    if (fd == -1) {
        return 0;
    }
    if (fd == target) {
        // dup2 would be a no-op and keep O_CLOEXEC set
        int flags = fcntl(fd, F_GETFD);
        return flags == -1 ? -1 : fcntl(fd, F_SETFD, flags & ~FD_CLOEXEC);
    }
    while (dup2(fd, target) == -1) {
        if (errno != EINTR) {
            return -1;
        }
    }
    return 0;
}

// Execute the process as specified. Assumes we are in the fork.
static void run_in_fork(
        const char * executable,
        char *const * args,
        const char* cd,
        char *const* env,
        int stdout_fd,
        int stderr_fd,
        int stdin_fd
        ) {
    if (lift_fd(&stdout_fd, STDOUT_FILENO) != 0 ||
            lift_fd(&stderr_fd, STDERR_FILENO) != 0 ||
            lift_fd(&stdin_fd, STDIN_FILENO) != 0 ||
            redirect_fd(stdout_fd, STDOUT_FILENO) != 0 ||
            redirect_fd(stderr_fd, STDERR_FILENO) != 0 ||
            redirect_fd(stdin_fd, STDIN_FILENO) != 0) {
        perror("Error redirecting standard streams");
        _exit(1);
    }

    // change working directory
    if (cd != NULL) {
        // we assume this works
        if (chdir(cd) != 0) {
            perror("Error selecting working directory");
            _exit(1);
        }
    }

    // execute process
    int execres;
    if (env != NULL) {
        execres = execve(executable, args, env);
    } else {
        execres = execv(executable, args);
    }
    if (execres != 0) {
        perror("Process execution failed");
        _exit(1);
    }
}

// fork and call run_in_fork
static pid_t fork_and_run(
        const char * executable,
        char *const * args,
        const char* cd,
        char *const* env,
        int stdout_fd,
        int stderr_fd,
        int stdin_fd
        ) {
    pid_t pid = fork();
    if (pid == 0) {
        run_in_fork(executable, args, cd, env, stdout_fd, stderr_fd, stdin_fd);
    }
    return pid;
}


// posix macros
static int w_exit_status(int status) {
    return WEXITSTATUS(status);
}
