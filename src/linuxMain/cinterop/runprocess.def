package = ksubprocess.iop

---
#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include <errno.h>
#include <fcntl.h>
#include <pthread.h>
#include <signal.h>
#include <time.h>
#include <unistd.h>
#include <stdio.h>

#include <sys/types.h>
#include <sys/wait.h>

static int pipe_cloexec(int* fds) {
    return pipe2(fds, O_CLOEXEC);
}

// write() that reports EPIPE without raising SIGPIPE, leaving the process-wide disposition untouched.
static ssize_t write_no_sigpipe(int fd, const void* buf, size_t count) {
    sigset_t pipe_set, pending, old;
    sigemptyset(&pipe_set);
    sigaddset(&pipe_set, SIGPIPE);
    sigpending(&pending);
    int was_pending = sigismember(&pending, SIGPIPE);

    pthread_sigmask(SIG_BLOCK, &pipe_set, &old);
    ssize_t res = write(fd, buf, count);
    int err = errno;
    if (res == -1 && err == EPIPE && !was_pending) {
        // consume the SIGPIPE this write generated before unblocking
        struct timespec zero = { 0, 0 };
        while (sigtimedwait(&pipe_set, NULL, &zero) == -1 && errno == EINTR) {}
    }
    pthread_sigmask(SIG_SETMASK, &old, NULL);
    errno = err;
    return res;
}

// Move fd out of the stdio range so redirecting another stream cannot overwrite it.
static int lift_fd(int* fd, int target) {
    if (*fd == -1 || *fd == target || *fd > STDERR_FILENO) {
        return 0;
    }
    *fd = fcntl(*fd, F_DUPFD_CLOEXEC, STDERR_FILENO + 1);
    return *fd == -1 ? -1 : 0;
}

// Make target refer to fd in the executed program. All parent fds are O_CLOEXEC, so the originals close on exec.
static int redirect_fd(int fd, int target) {
    if (fd == -1) {
        return 0;
    }
    if (fd == target) {
        // dup2 would be a no-op and keep O_CLOEXEC set
        int flags = fcntl(fd, F_GETFD);
        return flags == -1 ? -1 : fcntl(fd, F_SETFD, flags & ~FD_CLOEXEC);
    }
    while (dup2(fd, target) == -1) {
        if (errno != EINTR) {
            return -1;
        }
    }
    return 0;
}

// Stages reported through the error pipe when the child cannot run the program.
#define KSP_STAGE_REDIRECT 1
#define KSP_STAGE_CHDIR 2
#define KSP_STAGE_EXEC 3

// Tell the parent why the child failed. Only async-signal-safe calls are allowed after fork.
static void report_failure(int err_fd, int stage) {
    int msg[2] = { stage, errno };
    ssize_t res;
    do {
        res = write(err_fd, msg, sizeof(msg));
    } while (res == -1 && errno == EINTR);
    _exit(127);
}

// Execute the process as specified. Assumes we are in the fork.
static void run_in_fork(
        const char * executable,
        char *const * args,
        const char* cd,
        char *const* env,
        int stdout_fd,
        int stderr_fd,
        int stdin_fd,
        int err_fd
        ) {
    if (lift_fd(&err_fd, -1) != 0) {
        _exit(127);
    }
    if (lift_fd(&stdout_fd, STDOUT_FILENO) != 0 ||
            lift_fd(&stderr_fd, STDERR_FILENO) != 0 ||
            lift_fd(&stdin_fd, STDIN_FILENO) != 0 ||
            redirect_fd(stdout_fd, STDOUT_FILENO) != 0 ||
            redirect_fd(stderr_fd, STDERR_FILENO) != 0 ||
            redirect_fd(stdin_fd, STDIN_FILENO) != 0) {
        report_failure(err_fd, KSP_STAGE_REDIRECT);
    }

    if (cd != NULL && chdir(cd) != 0) {
        report_failure(err_fd, KSP_STAGE_CHDIR);
    }

    if (env != NULL) {
        execve(executable, args, env);
    } else {
        execv(executable, args);
    }
    report_failure(err_fd, KSP_STAGE_EXEC);
}

// fork and call run_in_fork
static pid_t fork_and_run(
        const char * executable,
        char *const * args,
        const char* cd,
        char *const* env,
        int stdout_fd,
        int stderr_fd,
        int stdin_fd,
        int err_fd
        ) {
    pid_t pid = fork();
    if (pid == 0) {
        run_in_fork(executable, args, cd, env, stdout_fd, stderr_fd, stdin_fd, err_fd);
    }
    return pid;
}

// Read the failure report written by the child. Returns 0 if exec succeeded, 1 if a report was read, -1 on error.
static int read_failure(int err_fd, int* stage, int* error) {
    int msg[2];
    size_t total = 0;
    while (total < sizeof(msg)) {
        ssize_t res = read(err_fd, ((char*) msg) + total, sizeof(msg) - total);
        if (res == -1) {
            if (errno == EINTR) {
                continue;
            }
            return -1;
        }
        if (res == 0) {
            break;
        }
        total += res;
    }
    if (total == 0) {
        return 0;
    }
    if (total != sizeof(msg)) {
        errno = EIO;
        return -1;
    }
    *stage = msg[0];
    *error = msg[1];
    return 1;
}


// posix macros
static int w_exit_status(int status) {
    return WEXITSTATUS(status);
}
